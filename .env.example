# Config por comercio (build-time): cada comercio corre su propia instalación
# completa de swaidemo, así que la PWA se buildea una vez por comercio con
# estos valores fijos — no hay pantalla de configuración en runtime.
#
# Copiar a .env.local (dev) o a .env.production (build de un comercio) y
# ajustar. Ver README.md para el detalle del proceso de build por comercio.

# URL base de la API móvil de ESE comercio, sin barra final. En dev, la que
# expone el docker-compose de swaidemo (ver CLAUDE.md del backend):
VITE_API_BASE_URL=http://localhost:8880/swaidemo/apps

# Nombre visible del comercio (navbar, login, manifest de la PWA).
VITE_COMERCIO_NOMBRE=SWAI ERP

# Pantalla "IA Lista PDF" (/importar). Apagada por defecto: sin "true" no
# aparece la pestaña y entrar por URL redirige a /buscar.
VITE_IMPORTAR_HABILITADO=false
