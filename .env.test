# Env de test (Vitest carga .env.test automáticamente en modo "test").
# La URL no necesita ser real: en unit tests nunca se llama; en integration
# tests MSW intercepta cualquier fetch a este origen.
VITE_API_BASE_URL=http://localhost:9999/mock-api
VITE_COMERCIO_NOMBRE=SWAI ERP Test
# La pantalla de importación está apagada por defecto en los builds, pero los
# tests siguen cubriéndola; el estado deshabilitado se prueba con vi.stubEnv.
VITE_IMPORTAR_HABILITADO=true
